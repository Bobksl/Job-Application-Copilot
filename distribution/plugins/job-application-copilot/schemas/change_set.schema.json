{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change_set.schema.json",
  "title": "Approved application change set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "change_set_id", "case_id", "artifact", "status", "target",
    "changes", "approvals", "qa", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "change_set_id": {"type": "string", "pattern": "^CHANGE-[A-Z0-9-]+$"},
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9-]+$"},
    "artifact": {"enum": ["resume", "cover_letter", "email"]},
    "status": {"enum": ["proposed", "approved", "applied", "rolled_back", "final"]},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "required_revision_id"],
      "properties": {
        "document_id": {"type": ["string", "null"], "maxLength": 200},
        "required_revision_id": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "changes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["location", "before", "after", "fact_ids"],
        "properties": {
          "location": {"type": "string", "minLength": 1, "maxLength": 300},
          "before": {"type": ["string", "null"], "maxLength": 5000},
          "after": {"type": "string", "minLength": 1, "maxLength": 5000},
          "fact_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^FACT-[A-Z0-9-]+$"}
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["approved_by", "approved_at", "change_set_id", "approved_content_sha256"],
        "properties": {
          "approved_by": {"type": "string", "minLength": 1, "maxLength": 100},
          "approved_at": {"type": "string", "format": "date-time"},
          "change_set_id": {"type": "string", "pattern": "^CHANGE-[A-Z0-9-]+$"},
          "approved_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "qa": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_check", "placeholders_resolved", "tone", "layout", "page_count"],
      "properties": {
        "fact_check": {"enum": ["pending", "pass", "fail"]},
        "placeholders_resolved": {"enum": ["pending", "pass", "fail"]},
        "tone": {"enum": ["pending", "pass", "fail"]},
        "layout": {"enum": ["pending", "pass", "fail", "not_applicable"]},
        "page_count": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
